# 复制为.env并填写，切勿提交真实密码
MYSQL_PASSWORD='replace-with-strong-application-password'
MYSQL_ROOT_PASSWORD='replace-with-another-strong-admin-password'
# 供本机Spring Boot进程读取的环境变量（compose .env 不会自动导出给shell）
MYSQL_USER=archive_app
MYSQL_URL='jdbc:mysql://localhost:3306/langchao_archive?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
REDIS_HOST=localhost
REDIS_PORT=6379
ARCHIVE_STORAGE_ROOT=./data
OCR_PROVIDER=disabled
OCR_ENDPOINT=
OCR_API_KEY=
