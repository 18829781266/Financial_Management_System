# Managed by huitong-cloud installer.
[Unit]
Description=汇通云服务器
After=network.target

[Service]
Type=simple
User=huitong
Group=huitong
WorkingDirectory=/opt/huitong/current
EnvironmentFile=/etc/huitong/huitong.env
ExecStart=/opt/huitong/node/bin/node /opt/huitong/current/deploy/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huitong
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=4096
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
