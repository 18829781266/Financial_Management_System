{
  "name": "huitong-electronic-archive",
  "version": "3.2.6",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run preview",
    "prebuild": "npm --prefix frontend ci",
    "build": "npm --prefix frontend run build",
    "postbuild": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist/client','dist',{recursive:true})\"",
    "setup": "npm --prefix frontend ci",
    "test": "npm --prefix frontend test",
    "preview": "npm --prefix frontend run preview",
    "auth:configure": "npm --prefix frontend run auth:configure",
    "db:local": "npm --prefix frontend run db:local",
    "test:server": "node --test deploy/*.test.mjs",
    "package:server": "node deploy/package.mjs"
  }
}
